// =====================================================================
// CONFORMED & SHARED DIMENSIONS
// =====================================================================

Table dim_date {
  date_key int [pk, increment]
  full_date date [not null, note: 'Non-dimension attribute']
  day int [note: 'Non-dimension attribute']
  month int [note: 'Hierarchy level']
  month_name varchar [note: 'Non-dimension attribute']
  year int [note: 'Hierarchy level']
  decade int [note: 'Hierarchy level']

  Note: 'Shared Date Dimension (Hierarchy: Date -> Month -> Year -> Decade)'
}

Table dim_movie {
  movie_key int [pk, increment]
  tmdb_movie_id int [note: 'Non-dimension attribute']
  imdb_title_id varchar [note: 'Non-dimension attribute']
  title varchar [not null]
  budget_tier varchar [note: 'Derived dimensional attribute']

  Note: 'Shared Movie Dimension'
}

Table dim_person {
  person_key int [pk, increment]
  person_id int [note: 'Non-dimension attribute']
  name varchar [not null]
  birth_year int
  death_year int

  Note: 'Person Dimension for Credits'
}

// =====================================================================
// SNOWFLAKE CREDIT ROLE DIMENSION HIERARCHY
// =====================================================================

Table dim_department {
  department_key int [pk, increment]
  department_name varchar [not null]
}

Table dim_job {
  job_key int [pk, increment]
  department_key int [ref: > dim_department.department_key]
  job_name varchar [not null]
}

Table dim_credit_role {
  credit_role_key int [pk, increment]
  job_key int [ref: > dim_job.job_key]
  credit_type varchar [note: 'CAST or CREW (Forked Hierarchy)']
  role_name varchar [not null]

  Note: 'Forked Hierarchy: Credit Role -> Job -> Department AND Credit Role -> Credit Type'
}

// =====================================================================
// GENRE & BRIDGE STRUCTURE
// =====================================================================

Table dim_genre {
  genre_key int [pk, increment]
  genre_name varchar [not null]
}

Table bridge_movie_genre {
  movie_key int [ref: > dim_movie.movie_key]
  genre_key int [ref: > dim_genre.genre_key]

  indexes {
    (movie_key, genre_key) [pk]
  }

  Note: 'Many-to-Many Bridge Table (Full Attribution Policy)'
}

// =====================================================================
// FACT SCHEMAS
// =====================================================================

// 1. Movie Performance Fact (Star Schema)
Table fact_movie_performance {
  movie_performance_id int [pk, increment]
  movie_key int [not null, ref: > dim_movie.movie_key]
  release_date_key int [not null, ref: > dim_date.date_key]

  // Measures
  revenue_worldwide decimal(15,2) [note: 'Additive (A)']
  revenue_domestic decimal(15,2) [note: 'Additive (A)']
  revenue_international decimal(15,2) [note: 'Additive (A)']
  budget decimal(15,2) [note: 'Additive (A)']
  profit decimal(15,2) [note: 'Additive (A)']
  vote_count int [note: 'Additive (A)']
  vote_avg decimal(3,2) [note: 'Non-Additive (NA)']
  weighted_score decimal(5,2) [note: 'Additive (A)']
  roi_ratio decimal(8,4) [note: 'Non-Additive (NA)']

  Note: 'Central performance fact table. Grain: 1 row per movie release.'
}

// 2. Movie Credit Fact (Factless Fact Schema)
Table fact_movie_credit {
  movie_credit_id int [pk, increment]
  movie_key int [not null, ref: > dim_movie.movie_key]
  person_key int [not null, ref: > dim_person.person_key]
  credit_role_key int [not null, ref: > dim_credit_role.credit_role_key]
  date_key int [not null, ref: > dim_date.date_key]

  Note: 'Factless fact table recording credit occurrences. Grain: 1 row per movie-person-credit occurrence.'
}