// =====================================================================
// CONFORMED & SHARED DIMENSIONS
// =====================================================================

Table dim_date {
  date_key int [pk, increment]
  full_date date [not null, note: 'Non-dimension attribute']
  day int [note: 'Non-dimension attribute']
  month int [note: 'Hierarchy level']
  month_name varchar [note: 'Non-dimension attribute']
  year int [note: 'Hierarchy level']
  decade int [note: 'Hierarchy level']

  Note: 'Shared Date Dimension (Hierarchy: Date -> Month -> Year -> Decade). Conformed across both facts.'
}

Table dim_movie {
  movie_key int [pk, increment]
  tmdb_movie_id int [note: 'Non-dimension attribute']
  imdb_title_id varchar [note: 'Non-dimension attribute']
  title varchar [not null]
  budget_tier varchar [note: 'Derived dimensional attribute']

  Note: 'Shared Movie Dimension. Conformed across both facts.'
}

Table dim_person {
  person_key int [pk, increment]
  person_id int [note: 'Non-dimension attribute']
  name varchar [not null]
  birth_year int
  death_year int

  Note: 'Person Dimension for Credits. Local to fact_movie_credit.'
}

// =====================================================================
// CREDIT ROLE DIMENSION (STAR — DENORMALIZED)
// =====================================================================

Table dim_credit_role {
  credit_role_key int [pk, increment]
  credit_type varchar [not null, note: 'CAST or CREW']
  job varchar [not null, note: 'e.g. Director, Producer, Actor']
  department varchar [not null, note: 'e.g. Directing, Sound, Acting']

  Note: 'Denormalized credit role dimension. Local to fact_movie_credit. No snowflaking: job/department cardinality is low, so full denormalization is the correct star-schema choice here.'
}

// =====================================================================
// GENRE & BRIDGE STRUCTURE
// =====================================================================

Table dim_genre {
  genre_key int [pk, increment]
  genre_name varchar [not null]

  Note: 'Reached only via bridge_movie_genre — a dimension of Movie, not of either fact directly.'
}

Table bridge_movie_genre {
  movie_key int [ref: > dim_movie.movie_key]
  genre_key int [ref: > dim_genre.genre_key]

  indexes {
    (movie_key, genre_key) [pk]
  }

  Note: 'Many-to-Many Bridge Table (Full Attribution Policy — no weight column, unweighted impact-query semantics)'
}

// =====================================================================
// FACT SCHEMAS
// =====================================================================

// 1. Movie Performance Fact (Star Schema)
Table fact_movie_performance {
  movie_performance_id int [pk, increment]
  movie_key int [not null, ref: > dim_movie.movie_key]
  release_date_key int [not null, ref: > dim_date.date_key]

  // Measures
  revenue_worldwide decimal(15,2) [note: 'Additive (A)']
  revenue_domestic decimal(15,2) [note: 'Additive (A)']
  revenue_international decimal(15,2) [note: 'Additive (A), Derived']
  budget decimal(15,2) [note: 'Additive (A)']
  profit decimal(15,2) [note: 'Additive (A), Derived']
  vote_count int [note: 'Additive (A), Support measure for vote_avg']
  vote_avg decimal(3,2) [note: 'Non-Additive (NA), Unit measure']
  weighted_score decimal(5,2) [note: 'Additive (A), Derived, Support measure for vote_avg']
  roi_ratio decimal(8,4) [note: 'Non-Additive (NA), Derived, Unit measure']

  Note: 'Primary fact table (not a view/aggregate — finest available grain). Grain: 1 row per movie.'
}

// 2. Movie Credit Fact (Factless Fact Schema)
Table fact_movie_credit {
  movie_credit_id int [pk, increment]
  movie_key int [not null, ref: > dim_movie.movie_key]
  person_key int [not null, ref: > dim_person.person_key]
  credit_role_key int [not null, ref: > dim_credit_role.credit_role_key]
  date_key int [not null, ref: > dim_date.date_key]

  Note: 'Factless fact table recording credit occurrences. Grain: 1 row per movie-person-credit_role occurrence.'
}